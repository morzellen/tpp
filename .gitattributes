# ====================================
# Auto detect text files and perform LF normalization
# ====================================
* text=auto eol=lf

# ====================================
# Explicitly declare text files you want to be checked in with LF
# ====================================
*.scala text eol=lf
*.sbt text eol=lf
*.sc text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.sh text eol=lf diff=shell
*.bat text eol=crlf diff=shell
*.cmd text eol=crlf diff=shell

# ====================================
# Docker
# ====================================
Dockerfile text eol=lf
docker-compose*.yml text eol=lf
.dockerignore text eol=lf

# ====================================
# Git
# ====================================
.gitattributes text eol=lf
.gitignore text eol=lf

# ====================================
# IDE settings (preserve line endings)
# ====================================
.editorconfig text eol=lf

# ====================================
# Binary files — mark explicitly
# ====================================
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.jar binary
*.class binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# ====================================
# GitHub specific
# ====================================
.github/ISSUE_TEMPLATE/*.md text eol=lf
.github/PULL_REQUEST_TEMPLATE.md text eol=lf
CODE_OF_CONDUCT.md text eol=lf
CONTRIBUTING.md text eol=lf
LICENSE text eol=lf
README.md text eol=lf

# ====================================
# Linguist overrides (for GitHub language stats)
# ====================================
*.sc linguist-language=Scala
*.sbt linguist-language=Scala
